# Copy this file to .env at the repo root. DJANGO_SECRET_KEY is required (a
# working local/demo key is already filled in below); everything else can
# stay blank, including any LLM provider key -- the app boots and serves the
# seeded demo data without one; only the LLM copy-generation step needs one.
#
#   cp .env.example .env
#
# .env is gitignored and never committed.

# --- Django -------------------------------------------------------------------
# Required. The key below is a fresh one generated for local/demo use only --
# fine to leave as-is for local dev, but generate your own for anything
# resembling production (e.g. `python -c "from django.core.management.utils
# import get_random_secret_key; print(get_random_secret_key())"`). The key
# that used to be hardcoded in project/settings.py was committed to git and is
# burned; it must never be reused.
DJANGO_SECRET_KEY=lHgPbSsslFdchK8dGnI9bvG3X4YkILAd_HuNfvjcwXzGOmrLEF

# Defaults to False (safe for production). Set to True for local dev if you
# want Django's debug pages/static serving.
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts, e.g. "example.com,www.example.com".
# Leave blank for local dev -- Django allows localhost/127.0.0.1 automatically
# when DEBUG=True. Required (non-empty) when DEBUG=False.
DJANGO_ALLOWED_HOSTS=

# Database backend, e.g. postgres://user:pass@host:5432/dbname. Leave unset to
# use the zero-setup SQLite fallback (./db.sqlite3). docker-compose.yml sets
# this for you to point at the bundled Postgres service.
DATABASE_URL=

# --- Copy grounding -----------------------------------------------------------
# How strictly generated outreach copy is checked against the lead record
# before it may be sent: off | standard (default) | strict. On any violation
# the draft is kept but routed to the BD review queue (needs_human=True).
COPY_VERIFY_LEVEL=standard

# --- Observability (MUS-25) ----------------------------------------------------
# OpenTelemetry is instrumented unconditionally but exports NOTHING unless an
# endpoint is set below: with no exporter configured the OTel API hands back a
# no-op tracer, so leaving these commented out is a fully supported state and
# costs nothing at startup (the SDK is not even imported).
#
# `docker compose up` sets these for you and runs Arize Phoenix; the values
# below are for running the app outside Docker against a Phoenix on localhost.
# Port 6006 serves both the Phoenix UI and its OTLP/HTTP collector -- the
# exporter appends /v1/traces itself, so give it the bare origin.
#
# A broken value here costs tracing and nothing else: an unparseable OTEL_*
# variable is logged and the app boots without telemetry.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# OTEL_SERVICE_NAME=outreach-planner
#
# Metrics have their own switch, deliberately. Phoenix ingests traces and is
# NOT an OTel metrics backend, so pointing metrics at it would be a steady
# trickle of 404s from a stack that is otherwise working. Set this only if you
# have a real metrics collector; `OUTREACH_OTEL_CONSOLE_METRICS=1` prints the
# histograms to stdout instead, which is usually what you actually want locally.
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318
# OUTREACH_OTEL_CONSOLE_METRICS=1

# --- LLM configuration (MUS-32) ------------------------------------------------
# The active provider/model/key selection lives in the database
# (LLMConfiguration), managed via the /api/llm/* endpoints, which sit behind
# the same magic-link session as the rest of the API (MUS-37)
# (GET /api/llm/catalog/, GET|PUT /api/llm/config/, POST /api/llm/config/test/)
# -- not in a config file. Run `python manage.py seed_llm_catalog` (also called
# by scripts/populate_demo_data.py) to populate the provider/model catalog those
# endpoints read from.
#
# The env vars below remain a fallback: they're used when no key has been
# saved to the database for the active provider (key_source="environment"),
# and by manage.py shell/scripts that call the LLM layer directly.

# Encrypts provider API keys stored in LLMConfiguration.encrypted_api_key
# (Fernet symmetric encryption). Deliberately separate from DJANGO_SECRET_KEY.
# Required (fails loudly at boot -- see project/app/checks.py) only once a key
# has actually been saved to the database; generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEY_ENCRYPTION_KEY=

# --- Default provider ---------------------------------------------------------
# groq: free tier, no credit card required. Get a key at https://console.groq.com
GROQ_API_KEY=

# --- Other supported providers ------------------------------------------------
# claude: the anthropic SDK reads ANTHROPIC_API_KEY. CLAUDE_API_KEY is accepted
# as an alias (see project/app/services/llm/config.py).
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=

# chatgpt
OPENAI_API_KEY=

# deepseek
DEEPSEEK_API_KEY=

# --- Magic-link auth (MUS-37) -------------------------------------------------
# Comma-separated allowlist. An email not on this list gets an identical
# response from POST /api/auth/request-link/ but no link is ever minted.
LOGIN_ALLOWED_EMAILS=

# console (default; prints the link to the server log, and returns dev_link in
# the API response when DJANGO_DEBUG=True) | email (uses Django's email backend)
LOGIN_LINK_DELIVERY=console
LOGIN_TOKEN_TTL_SECONDS=900
LOGIN_LINK_BASE_URL=http://127.0.0.1:8000
LOGIN_RATE_LIMIT_EMAIL=5/hour
LOGIN_RATE_LIMIT_IP=20/hour
LOGIN_RESEND_COOLDOWN_SECONDS=30

# --- Triage queue (MUS-39) ----------------------------------------------------
# How long after a decision the reviewer can still undo it, in seconds. The
# server is authoritative: `undo.expires_at` is an absolute server timestamp
# and `undo.available` is server-computed (CONTRACT MUS-35 section 9.6).
TRIAGE_UNDO_WINDOW_SECONDS=300

# Backstop for the `on_activity` snooze ("come back when they actually do
# something"). A lead that never does anything would otherwise be hidden
# forever -- indistinguishable from a dismiss nobody chose (section 9.17).
TRIAGE_SNOOZE_ON_ACTIVITY_BACKSTOP_DAYS=14

# The timezone the server uses to decide what "today" means for the queue
# header, the /done view and 09:00 snooze targets. The frontend never computes
# a day boundary itself (section 9.5).
TRIAGE_TIMEZONE=UTC
