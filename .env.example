# Copy this file to .env at the repo root and fill in the key for whichever
# provider config.toml selects (`[llm] provider = ...`). Only that one key is
# required; the rest can stay blank.
#
#   cp .env.example .env
#
# .env is gitignored and never committed.

# --- Default provider ---------------------------------------------------------
# groq: free tier, no credit card required. Get a key at https://console.groq.com
GROQ_API_KEY=

# --- Other supported providers ------------------------------------------------
# claude: the anthropic SDK reads ANTHROPIC_API_KEY. CLAUDE_API_KEY is accepted
# as an alias and normalized to ANTHROPIC_API_KEY by project/settings.py.
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=

# chatgpt
OPENAI_API_KEY=

# deepseek
DEEPSEEK_API_KEY=
