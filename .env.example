# Turn this file into your .env with:
#
#   python scripts/setup_env.py
#
# which copies it and fills in a freshly generated DJANGO_SECRET_KEY. That key
# is the one required value; everything else can stay blank, including any LLM
# provider key -- the app boots and serves the seeded demo data without one,
# and only the LLM copy-generation step needs one.
#
# .env is gitignored and never committed.

# --- Django -------------------------------------------------------------------
# Required -- the app refuses to boot without it. Deliberately blank here: a
# secret committed to the repository is a secret everyone who can read the
# repository has. Generate your own, either with
#
#   python scripts/setup_env.py
#
# or, to fill this line in by hand,
#
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
#
# The key that used to be hardcoded in project/settings.py was committed to git
# and is burned; it must never be reused.
DJANGO_SECRET_KEY=

# Blank means the default, False, which is the safe setting. Set it to True for
# local dev if you want Django's debug pages and static serving -- never for
# anything reachable from outside your machine.
DJANGO_DEBUG=

# Comma-separated list of allowed hosts, e.g. "example.com,www.example.com".
# Leave blank for local dev -- Django allows localhost/127.0.0.1 automatically
# when DEBUG=True. Required (non-empty) when DEBUG=False.
DJANGO_ALLOWED_HOSTS=

# Comma-separated origins, scheme included, whose POSTs the CSRF check trusts,
# e.g. "https://demo.example.com". Leave blank for local dev. Needed whenever
# TLS terminates in front of the app (reverse proxy, tunnel): the browser sends
# an https Origin, the app sees http, and every authenticated POST is a 403
# until the origin is listed here.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database backend, e.g. postgres://user:pass@host:5432/dbname. Leave unset to
# use the zero-setup SQLite fallback (./db.sqlite3). docker-compose.yml sets
# this for you to point at the bundled Postgres service.
DATABASE_URL=

# --- Copy grounding -----------------------------------------------------------
# How strictly generated outreach copy is checked against the lead record
# before it may be sent: off | standard (default) | strict. On any violation
# the draft is kept but routed to the BD review queue (needs_human=True).
COPY_VERIFY_LEVEL=standard

# --- Planner concurrency, retries and timeouts (MUS-26) ------------------------
# How hard the planner drives the provider during a run. All optional -- the
# defaults below are what the app uses when these are unset (blank counts as
# unset, so you can empty a line rather than delete it), and they are tuned for
# the default free Groq tier. Every value is checked at boot by `manage.py
# check`, and a bad one fails with the name of the variable that caused it.
#
# How many provider calls may be outstanding at once. Raising it speeds the run
# up until the provider starts throttling, at which point it makes things worse.
OUTREACH_MAX_IN_FLIGHT=8
# Total attempts per lead, not retries: 1 means "call once, no retry".
OUTREACH_MAX_ATTEMPTS=4
# Full-jitter exponential backoff between attempts, in seconds. A provider's
# own Retry-After header wins on magnitude when it sends one, capped by
# OUTREACH_MAX_BACKOFF_S. The multiplier must be >= 1 (backoff must not shrink).
OUTREACH_INITIAL_BACKOFF_S=0.5
OUTREACH_MAX_BACKOFF_S=30.0
OUTREACH_BACKOFF_MULTIPLIER=2.0
# Two nested deadlines. The first bounds one HTTP attempt; the second bounds the
# whole retry loop for one lead, so a single lead cannot hold one of the
# OUTREACH_MAX_IN_FLIGHT slots for the entire retry budget.
OUTREACH_REQUEST_TIMEOUT_S=60.0
OUTREACH_PER_LEAD_TIMEOUT_S=150.0

# --- LLM configuration (MUS-32) ------------------------------------------------
# The active provider/model/key selection lives in the database
# (LLMConfiguration), managed via the /api/llm/* endpoints, which sit behind
# the same magic-link session as the rest of the API (MUS-37)
# (GET /api/llm/catalog/, GET|PUT /api/llm/config/, POST /api/llm/config/test/)
# -- not in a config file. Run `python manage.py seed_llm_catalog` (also called
# by scripts/populate_demo_data.py) to populate the provider/model catalog those
# endpoints read from.
#
# The env vars below remain a fallback: they're used when no key has been
# saved to the database for the active provider (key_source="environment"),
# and by manage.py shell/scripts that call the LLM layer directly.

# Encrypts provider API keys stored in LLMConfiguration.encrypted_api_key
# (Fernet symmetric encryption). Deliberately separate from DJANGO_SECRET_KEY.
# Required (fails loudly at boot -- see project/app/checks.py) only once a key
# has actually been saved to the database; generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEY_ENCRYPTION_KEY=

# --- Default provider ---------------------------------------------------------
# groq: free tier, no credit card required. Get a key at https://console.groq.com
GROQ_API_KEY=

# --- Other supported providers ------------------------------------------------
# claude: the anthropic SDK reads ANTHROPIC_API_KEY. CLAUDE_API_KEY is accepted
# as an alias (see project/app/services/llm/config.py).
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=

# chatgpt
OPENAI_API_KEY=

# deepseek
DEEPSEEK_API_KEY=

# --- Magic-link auth (MUS-37) -------------------------------------------------
# Comma-separated allowlist. An email not on this list gets an identical
# response from POST /api/auth/request-link/ but no link is ever minted.
LOGIN_ALLOWED_EMAILS=

# console (default; prints the link to the server log, and returns dev_link in
# the API response when DJANGO_DEBUG=True) | email (uses Django's email backend)
LOGIN_LINK_DELIVERY=console
LOGIN_TOKEN_TTL_SECONDS=900
LOGIN_LINK_BASE_URL=http://127.0.0.1:8000
LOGIN_RATE_LIMIT_EMAIL=5/hour
LOGIN_RATE_LIMIT_IP=20/hour
LOGIN_RESEND_COOLDOWN_SECONDS=30
