# Copy this file to .env at the repo root. DJANGO_SECRET_KEY is required (a
# working local/demo key is already filled in below); everything else can
# stay blank, including the LLM provider key for whichever provider
# config.toml selects (`[llm] provider = ...`).
#
#   cp .env.example .env
#
# .env is gitignored and never committed.

# --- Django -------------------------------------------------------------------
# Required. The key below is a fresh one generated for local/demo use only --
# fine to leave as-is for local dev, but generate your own for anything
# resembling production (e.g. `python -c "from django.core.management.utils
# import get_random_secret_key; print(get_random_secret_key())"`). The key
# that used to be hardcoded in project/settings.py was committed to git and is
# burned; it must never be reused.
DJANGO_SECRET_KEY=lHgPbSsslFdchK8dGnI9bvG3X4YkILAd_HuNfvjcwXzGOmrLEF

# Defaults to False (safe for production). Set to True for local dev if you
# want Django's debug pages/static serving.
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts, e.g. "example.com,www.example.com".
# Leave blank for local dev -- Django allows localhost/127.0.0.1 automatically
# when DEBUG=True. Required (non-empty) when DEBUG=False.
DJANGO_ALLOWED_HOSTS=

# Database backend, e.g. postgres://user:pass@host:5432/dbname. Leave unset to
# use the zero-setup SQLite fallback (./db.sqlite3). docker-compose.yml sets
# this for you to point at the bundled Postgres service.
DATABASE_URL=

# --- Copy grounding -----------------------------------------------------------
# How strictly generated outreach copy is checked against the lead record
# before it may be sent: off | standard (default) | strict. On any violation
# the draft is kept but routed to the BD review queue (needs_human=True).
COPY_VERIFY_LEVEL=standard

# --- Default provider ---------------------------------------------------------
# groq: free tier, no credit card required. Get a key at https://console.groq.com
GROQ_API_KEY=

# --- Other supported providers ------------------------------------------------
# claude: the anthropic SDK reads ANTHROPIC_API_KEY. CLAUDE_API_KEY is accepted
# as an alias and normalized to ANTHROPIC_API_KEY by project/settings.py.
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=

# chatgpt
OPENAI_API_KEY=

# deepseek
DEEPSEEK_API_KEY=
