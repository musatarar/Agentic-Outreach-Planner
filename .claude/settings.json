{
  "permissions": {
    "allow": [
      "Bash(python manage.py test project.app*)",
      "Bash(coverage run manage.py test project.app)",
      "Bash(coverage report*)",
      "Bash(python manage.py makemigrations --check --dry-run)",
      "Bash(python manage.py migrate)",
      "Bash(python manage.py check)",
      "Bash(python evals/run_rules_eval.py)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(mypy project/app/services/)",
      "Bash(npm ci*)",
      "Bash(npm run typecheck)",
      "Bash(npm test*)",
      "Bash(npm run build)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
